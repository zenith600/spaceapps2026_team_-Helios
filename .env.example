# Copy to .env. Never commit .env.
# --- shared ---
DEMO_MODE=1                      # 1 = serve frozen files, no NASA/GPU/LLM access
DATA_DIR=./data/release          # where the pipeline outputs live (parquet, stamps, dossiers)
PATCH_COUNT=3                    # number of sky patches to search
PATCH_MAX_EXPOSURES=40           # cap on SPHEREx cutouts per patch
# --- api ---
API_PORT=8000
SQLITE_PATH=./deepfield_local.sqlite
SUPABASE_URL=                    # optional; if set with the key below, votes go to Supabase
SUPABASE_SERVICE_KEY=
CORS_ORIGINS=http://localhost:3000
# --- agents ---
ANTHROPIC_API_KEY=               # optional; without it dossiers use the offline template generator
ANTHROPIC_MODEL=claude-sonnet-4-5
# --- LLM field explanations (optional; OpenAI-compatible endpoint) ---
# Writes the plain-language "what to look for" line for coordinates that are not in the
# built-in catalogue. Without a key the viewer simply shows the measured facts instead.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=                     # never commit a real key; .env is gitignored
# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=1
